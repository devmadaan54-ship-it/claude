# PolyMind Backend Environment Variables

# Set to False to use real API calls (default: True for testing)
MOCK_MODE=True

# API Keys (optional if MOCK_MODE=True)
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GOOGLE_API_KEY=your-google-api-key
GROQ_API_KEY=your-groq-api-key

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# ============== Tracxn Data API ==============
# Tracxn is a REST API, not a SQL database - there is no host/port to connect to.
# Generate an access token at https://platform.tracxn.com/a/api/apitoken
TRACXN_ACCESS_TOKEN=your-tracxn-access-token

# Set to False to make real Tracxn calls (each call consumes account credits)
TRACXN_MOCK_MODE=True

TRACXN_BASE_URL=https://platform.tracxn.com/api/2.2
# Header carrying the token. Run `python scripts/check_tracxn.py --probe-headers`
# to confirm which one your account accepts.
TRACXN_AUTH_HEADER=accessToken
TRACXN_TIMEOUT=30
TRACXN_MAX_RETRIES=3
